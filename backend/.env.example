# ── PostgreSQL (Railway provides DATABASE_URL automatically) ──
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT ───────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=12h

# ── Super Admin Credentials ───────────────────────────────────
ADMIN_EMAIL=admin@pos.com
ADMIN_PASSWORD=YourStrongAdminPassword123!

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── CORS: URL of your deployed React frontend ─────────────────
FRONTEND_URL=https://your-frontend.railway.app

# ── Daily Email Summary (used by Google Apps Script) ──────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DAILY_SUMMARY_KEY=replace_with_a_long_random_secret

# ── Firebase FCM (push notifications — existing mobile app) ───
# Project Settings → Service Accounts → Generate new private key (for FCM project)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-fcm-project",...}

# ── Firebase Storage (agent document uploads — separate project) ──
# Different service account from a second Firebase project (or same project)
# Paste JSON as single line: cat storage-service-account.json | tr -d '\n'
FIREBASE_STORAGE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-storage-project",...}
# Firebase console → Storage → bucket name without gs:// prefix
FIREBASE_STORAGE_BUCKET=your-storage-project.appspot.com

# ── HelaPlay / HelaPOS System-level Billing QR ────────────────
# Platform credentials used to generate QR codes for shop activation payments.
# These are NOT per-shop — they belong to the BillFlow platform account.
# HelaPOS Merchant Portal → My Account → API Credentials
HELAPOS_SYSTEM_APP_ID=o6rFVWv50kvm7KtR4BquQ_zbHgJcLkU0fUUV79DaUcs
HELAPOS_SYSTEM_APP_SECRET=xz1X4pizNByQUCKE5X_Zf7uD8vANPQH987bFiDNNV7Y
HELAPOS_SYSTEM_BUSINESS_ID=9042
# Business User ID (for reference / future use)
HELAPOS_SYSTEM_BUSINESS_USER_ID=22738
